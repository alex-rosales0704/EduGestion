<%- include('../partials/header',{title}) %>
<section class="page-head"><div><a class="back-link" href="/admin/<%= type %>"><svg class="icon"><use href="/img/icons.svg#arrow-left"></use></svg> Volver a <%= d.title.toLowerCase() %></a><h1><%= title %></h1><p>Completa los datos de este registro. Los campos marcados con * son obligatorios.</p></div></section>
<div class="form-layout"><section class="card form-card"><div class="form-section-head"><span class="form-section-icon"><svg class="icon"><use href="/img/icons.svg#edit"></use></svg></span><div><h2>Información general</h2><p><%= id?'Edita los datos del registro seleccionado.':'Ingresa la información para crear un nuevo registro.' %></p></div></div>
<form method="post" action="/admin/<%= type %><%= id?'/'+id:'' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-fields">
<% d.fields.forEach(f=>{const val=item[f.name]??'';const readonly=!!id&&f.createOnly;%>
<div class="field-group <%= f.type==='textarea'?'span-2':'' %>"><label for="field_<%= f.name %>"><%= f.label %><% if(f.required){%><span class="required"> *</span><%}%></label>
<% if(f.type==='select'){%><select id="field_<%= f.name %>" name="<%= f.name %>" <%= readonly?'disabled':'' %> <%= f.required?'required':'' %>><option value="">Selecciona una opción</option><% (options[f.source]||[]).forEach(op=>{%><option value="<%= op.id %>" <%= String(op.id)===String(val)?'selected':'' %>><%= op.label %></option><%})%><% if(readonly && !options[f.source]?.some(o=>String(o.id)===String(val))){%><option selected><%= val %> (histórico)</option><%}%></select>
<%} else if(f.type==='textarea'){%><textarea id="field_<%= f.name %>" name="<%= f.name %>" rows="4" maxlength="<%= f.max||1000 %>" placeholder="Escribe una descripción..."><%= val %></textarea>
<%} else {%><input id="field_<%= f.name %>" type="<%= f.type||'text' %>" name="<%= f.name %>" value="<%= val %>" <%= f.required?'required':'' %> <%= f.max?'maxlength='+f.max:'' %> <%= f.type==='number'?'step=0.01 min='+f.min+' max='+f.max:'' %> placeholder="<%= f.type==='date'?'':f.label %>"><%}%>
</div><%})%>
</div><div class="form-actions"><a href="/admin/<%= type %>" class="btn outline">Cancelar</a><button class="btn primary" type="submit"><svg class="icon"><use href="/img/icons.svg#check"></use></svg> <%= id?'Guardar cambios':'Crear registro' %></button></div></form></section>
<aside class="form-tips"><div class="tip-icon"><svg class="icon"><use href="/img/icons.svg#shield"></use></svg></div><h3>Integridad de los datos</h3><p>El servidor valida los datos, relaciones y reglas del ciclo antes de guardar en MySQL.</p><div class="tip-separator"></div><span><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Verificación de campos</span><span><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Restricciones de negocio</span><span><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Conexión segura a la base</span></aside></div>
<%- include('../partials/footer') %>
