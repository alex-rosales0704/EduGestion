<%- include('../partials/header',{title}) %>
<section class="page-head"><div><div class="eyebrow">ADMINISTRACIÓN <span class="eyebrow-divider"></span> GESTIÓN DE REGISTROS</div><h1><%= title %></h1><p>Consulta y administra la información académica almacenada en el sistema.</p></div><a class="btn primary" href="/admin/<%= type %>/nuevo"><svg class="icon"><use href="/img/icons.svg#plus"></use></svg> Nuevo registro</a></section>
<section class="card data-card"><div class="data-toolbar"><div><h2>Listado de <%= title.toLowerCase() %></h2><span><%= rows.length %> registros disponibles</span></div><label class="search-box"><svg class="icon"><use href="/img/icons.svg#search"></use></svg><input type="search" data-table-search="records" placeholder="Buscar registro..." aria-label="Buscar registros"></label></div>
<div class="table-scroll"><table id="records"><thead><tr><th>ID</th><% d.columns.forEach(([_,label])=>{ %><th><%= label %></th><% }) %><th>Acciones</th></tr></thead><tbody>
<% if(!rows.length){ %><tr class="placeholder-row"><td colspan="<%= d.columns.length+2 %>" class="empty-cell"><svg class="icon"><use href="/img/icons.svg#folder"></use></svg> No hay registros todavía. Utiliza «Nuevo registro» para empezar.</td></tr><% } %>
<% rows.forEach(r=>{ %><tr class="data-row"><td><span class="id-mark">#<%= r.id %></span></td><% d.columns.forEach(([field])=>{ %><td><% const raw=r[field]; const estado=['ABIERTO','CERRADO','ACTIVA','RETIRADA','Activo','Inactivo','Activa','Inactiva'].includes(String(raw));%><% if(estado) { %><span class="status-pill <%= ['ABIERTO','ACTIVA','Activo','Activa'].includes(String(raw))?'status-active':'status-off' %>"><%= raw %></span><% } else { %><%= raw ?? '—' %><% } %></td><% }) %>
<td><div class="row-actions">
<% if(d.editable && r.estado!=='CERRADO') { %><a class="btn small outline" href="/admin/<%= type %>/<%= r.id %>/editar"><svg class="icon"><use href="/img/icons.svg#edit"></use></svg> Editar</a><% } %>
<% if(d.close && r.estado==='ABIERTO') { %><form action="/admin/<%= type %>/<%= r.id %>/close" method="post" class="confirm-action" data-confirm="¿Cerrar este registro? No podrás modificarlo después."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger-soft" type="submit">Cerrar</button></form><% } %>
<% if(d.deactivate && r.activa) { %><form action="/admin/<%= type %>/<%= r.id %>/deactivate" method="post" class="confirm-action" data-confirm="¿Desactivar este registro? El historial se conservará."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger-soft" type="submit">Desactivar</button></form><% } %>
<% if(d.retire && r.estado==='ACTIVA') { %><form action="/admin/<%= type %>/<%= r.id %>/retire" method="post" class="confirm-action" data-confirm="¿Retirar matrícula? Se conservará el historial."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger-soft" type="submit">Retirar</button></form><% } %>
</div></td></tr><% }) %>
</tbody></table><div class="no-results" hidden>No se encontraron registros con ese término.</div></div><div class="table-bottom"><span data-count-visible><%= rows.length %> registros</span><span>Los cambios se guardan directamente en MySQL.</span></div></section>
<%- include('../partials/footer') %>
