<%- include('../partials/header',{title}) %>
<section class="page-head"><div><div class="eyebrow">EXPEDIENTES <span class="eyebrow-divider"></span> GESTIÓN DE USUARIOS</div><h1><%= title %></h1><p>Gestiona los registros y las credenciales de acceso al sistema.</p></div><a class="btn primary" href="/admin/<%= type %>/nuevo"><svg class="icon"><use href="/img/icons.svg#plus"></use></svg> Agregar <%= type==='estudiantes'?'estudiante':'docente' %></a></section>
<section class="card data-card"><div class="data-toolbar"><div><h2>Directorio de <%= type %></h2><span><%= rows.length %> cuentas encontradas</span></div><label class="search-box"><svg class="icon"><use href="/img/icons.svg#search"></use></svg><input type="search" data-table-search="records" placeholder="Nombre, correo o código..." aria-label="Buscar usuarios"></label></div>
<div class="table-scroll"><table id="records"><thead><tr><th>ID</th><th><%= code==='carnet'?'Carnet':'Código docente' %></th><th>Nombre completo</th><th>Correo institucional</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<% if(!rows.length){ %><tr class="placeholder-row"><td colspan="6" class="empty-cell">Todavía no hay expedientes. Crea el primero.</td></tr><% } %>
<% rows.forEach(r=>{ %><tr class="data-row"><td><span class="id-mark">#<%= r.id %></span></td><td class="mono"><%= r[code] %></td><td><span class="table-person"><span class="person-avatar"><%= r.nombres[0] %></span><b><%= r.nombres %> <%= r.apellidos %></b></span></td><td><%= r.correo %></td><td><span class="status-pill <%= r.activo?'status-active':'status-off' %>"><%= r.estado_texto %></span></td><td><div class="row-actions"><a class="btn small outline" href="/admin/<%= type %>/<%= r.id %>/editar"><svg class="icon"><use href="/img/icons.svg#edit"></use></svg> Editar</a>
<% if(r.activo){ %><form method="post" action="/admin/<%= type %>/<%= r.id %>/deactivate" class="confirm-action" data-confirm="¿Desactivar esta cuenta? La información se conservará."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger-soft" type="submit">Desactivar</button></form><% } %></div></td></tr><% }) %>
</tbody></table><div class="no-results" hidden>No se encontraron coincidencias.</div></div><div class="table-bottom"><span data-count-visible><%= rows.length %> registros</span><span>La desactivación conserva el historial académico.</span></div></section>
<%- include('../partials/footer') %>
