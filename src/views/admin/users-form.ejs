<%- include('../partials/header',{title}) %>
<section class="page-head"><div><a class="back-link" href="/admin/<%= type %>"><svg class="icon"><use href="/img/icons.svg#arrow-left"></use></svg> Volver a <%= type %></a><h1><%= title %></h1><p>Gestiona los datos personales y las credenciales de acceso.</p></div></section>
<div class="form-layout"><section class="card form-card"><div class="form-section-head"><span class="form-section-icon"><svg class="icon"><use href="/img/icons.svg#user"></use></svg></span><div><h2>Datos del <%= type==='estudiantes'?'estudiante':'docente' %></h2><p>Los datos obligatorios están marcados con *</p></div></div>
<form method="post" action="/admin/<%= type %><%= id?'/'+id:'' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-fields">
<div class="field-group span-2"><label for="correo">Correo institucional <span class="required">*</span></label><input id="correo" type="email" name="correo" maxlength="150" value="<%= item.correo??'' %>" placeholder="correo@institucion.edu" required></div>
<div class="field-group"><label for="codigo"><%= code==='carnet'?'Carnet estudiantil':'Código docente' %> <span class="required">*</span></label><input id="codigo" name="<%= code %>" maxlength="30" value="<%= item[code]??'' %>" placeholder="<%= code==='carnet'?'EST010':'DOC010' %>" required></div>
<div class="field-group"><label for="nombres">Nombres <span class="required">*</span></label><input id="nombres" name="nombres" maxlength="90" value="<%= item.nombres??'' %>" placeholder="Nombres" required></div>
<div class="field-group"><label for="apellidos">Apellidos <span class="required">*</span></label><input id="apellidos" name="apellidos" maxlength="90" value="<%= item.apellidos??'' %>" placeholder="Apellidos" required></div>
<% const nombresCampo={fecha_nacimiento:'Fecha de nacimiento',fecha_ingreso:'Fecha de ingreso',telefono:'Teléfono',direccion:'Dirección',especialidad:'Especialidad'}; %>
<% fields.filter(f=>!['nombres','apellidos'].includes(f)).forEach(f=>{ %><div class="field-group"><label for="<%= f %>"><%= nombresCampo[f]||f %></label><input id="<%= f %>" type="<%= f.startsWith('fecha_')?'date':'text' %>" name="<%= f %>" value="<%= item[f]??'' %>" placeholder="<%= nombresCampo[f]||f %>"></div><% }) %>
<div class="field-group span-2"><label for="password"><%= id?'Nueva contraseña (opcional)':'Contraseña inicial' %><%= id?'':' *' %></label><input id="password" type="password" name="password" minlength="8" <%= id?'':'required' %> placeholder="<%= id?'Dejar vacío para no cambiar':'Mínimo 8 caracteres' %>" autocomplete="new-password"><small class="field-hint">La contraseña se guarda protegida con hash bcrypt.</small></div>
</div><div class="form-actions"><a class="btn outline" href="/admin/<%= type %>">Cancelar</a><button class="btn primary" type="submit"><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Guardar expediente</button></div></form></section>
<aside class="form-tips"><div class="tip-icon"><svg class="icon"><use href="/img/icons.svg#lock"></use></svg></div><h3>Acceso personal</h3><p>El correo y el carnet o código docente no pueden repetirse. La contraseña nunca se almacena en texto plano.</p><div class="tip-separator"></div><span><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Correo único</span><span><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Código institucional único</span><span><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Protección de credenciales</span></aside></div>
<%- include('../partials/footer') %>
