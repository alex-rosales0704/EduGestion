<%- include('../partials/header',{title}) %>
<section class="page-head"><div><div class="eyebrow">SPRINT III / GESTIÓN DE ARCHIVOS</div><h1>Documentos académicos</h1><p>Adjunta documentos a expedientes de estudiantes. Los archivos se guardan en disco privado y su referencia en MySQL.</p></div><span class="subtle-badge"><%= documentos.length %> archivos</span></section>
<section class="card upload-card"><div class="section-heading"><div><h2>Adjuntar documento</h2><p>Formatos admitidos: PDF, JPG, PNG. Tamaño máximo: 5 MB.</p></div></div>
<form method="post" action="/admin/documentos" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-fields">
<div class="field-group"><label for="estudiante">Estudiante <span class="required">*</span></label><select id="estudiante" name="estudiante_id" required><option value="">Selecciona un expediente</option><% estudiantes.forEach(e=>{ %><option value="<%= e.id %>"><%= e.label %></option><% }) %></select></div>
<div class="field-group"><label for="archivo">Archivo (5 MB máximo) <span class="required">*</span></label><input id="archivo" type="file" name="archivo" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" required></div>
<div class="field-group span-2"><label for="descripcion">Descripción <span class="required">*</span></label><input id="descripcion" type="text" name="descripcion" minlength="3" maxlength="200" required placeholder="Ej.: Constancia de inscripción, fotografía o certificado"></div></div><div class="form-actions"><button class="btn primary" type="submit">Guardar documento</button></div></form></section>
<section class="card data-card"><div class="data-toolbar"><div><h2>Archivos registrados</h2><span>Solo los perfiles autorizados pueden descargarlos</span></div><label class="search-box"><input type="search" data-table-search="records" placeholder="Buscar estudiante o archivo" aria-label="Buscar archivos"></label></div><div class="table-scroll"><table id="records"><thead><tr><th>Documento</th><th>Estudiante</th><th>Descripción</th><th>Fecha</th><th>Acciones</th></tr></thead><tbody>
<% if(!documentos.length){ %><tr><td colspan="5" class="empty-cell">Aún no hay documentos adjuntos.</td></tr><% } %>
<% documentos.forEach(d=>{ %><tr class="data-row"><td><b><%= d.nombre_original %></b><small class="block-note"><%= (d.tamano_bytes/1024).toFixed(0) %> KB · <%= d.tipo_mime %></small></td><td><%= d.carnet %> · <%= d.estudiante %></td><td><%= d.descripcion %></td><td><%= new Date(d.creado_at).toLocaleDateString('es-SV') %></td><td><div class="row-actions"><a class="btn small outline" target="_blank" rel="noopener" href="/documentos/<%= d.id %>/ver">Ver archivo</a><a class="btn small outline" href="/documentos/<%= d.id %>/descargar">Descargar</a><form action="/admin/documentos/<%= d.id %>/eliminar" method="post" class="confirm-action" data-confirm="¿Retirar este documento del listado?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger-soft">Retirar</button></form></div></td></tr><% }) %>
</tbody></table><div class="no-results" hidden>No hay resultados.</div></div><div class="table-bottom"><span data-count-visible><%= documentos.length %> archivos</span><span>Conserva los originales bajo control de acceso.</span></div></section>
<%- include('../partials/footer') %>
