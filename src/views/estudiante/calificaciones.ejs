<%- include('../partials/header',{title}) %>
<section class="page-head"><div><div class="eyebrow">PORTAL ESTUDIANTIL <span class="eyebrow-divider"></span> MI DESEMPEÑO</div><h1>Mi historial académico <span class="title-wave">✦</span></h1><p><%= estudiante.nombres %> <%= estudiante.apellidos %> · Carnet <%= estudiante.carnet %></p></div><a href="/estudiante/boleta" class="btn primary"><svg class="icon"><use href="/img/icons.svg#download"></use></svg> Descargar boleta PDF</a></section>
<div class="student-banner"><div class="student-banner-icon"><svg class="icon"><use href="/img/icons.svg#school"></use></svg></div><div><span>BIENVENIDO A TU ESPACIO</span><h2>Tu progreso, a tu alcance.</h2><p>Consulta tus asignaturas, notas y promedios actualizados.</p></div><div class="student-banner-art"><div></div><div></div><div></div></div></div>
<% if(!historial.length){ %><div class="card empty-state"><svg class="icon"><use href="/img/icons.svg#book"></use></svg><h3>No hay matrículas registradas</h3><p>Cuando el administrador matricule tu cuenta, verás tus asignaturas aquí.</p></div><% } %>
<% historial.forEach(ciclo=>{const aprobadas=ciclo.materias.filter(m=>m.calculo.completo&&m.calculo.promedioFinal>=6).length;const completas=ciclo.materias.filter(m=>m.calculo.completo).length;%>
<section class="student-cycle"><div class="section-heading"><div><h2>Ciclo <%= ciclo.ciclo %> · Sección <%= ciclo.seccion %></h2><p><%= ciclo.materias.length %> asignaturas · <%= completas %> con promedio final · <%= aprobadas %> aprobadas</p></div><span class="status-pill <%= ciclo.estado_ciclo==='ABIERTO'?'status-active':'status-off' %>"><%= ciclo.estado_ciclo %></span></div>
<div class="subject-grid"><% ciclo.materias.forEach((m,index)=>{const nota=m.calculo.completo?m.calculo.promedioFinal:null;const pct=Math.min(100,(nota===null?m.calculo.ponderadoAcumulado:nota)*10); %>
<article class="subject-card"><div class="subject-top"><span class="subject-icon m<%= index%4 %>"><svg class="icon"><use href="/img/icons.svg#book"></use></svg></span><span class="mono subject-code"><%= m.codigo %></span></div><h3><%= m.asignatura %></h3><p class="subject-caption"><%= m.calculo.completo?'Promedio final':'Avance provisional' %></p><div class="subject-grade"><strong><%= (nota===null?m.calculo.ponderadoAcumulado:nota).toFixed(2) %></strong><span>/ 10.00</span></div>
<div class="grade-progress"><span style="width:<%= pct %>%"></span></div><div class="subject-state"><span class="status-pill <%= m.calculo.completo?(nota>=6?'status-active':'status-off'):'status-pending' %>"><%= m.calculo.completo?(nota>=6?'Aprobado':'Reprobado'):'En progreso' %></span><span><%= m.calculo.calificacionesRegistradas %> / <%= m.periodos.length %> periodos</span></div>
<details class="period-details"><summary>Ver detalle por periodo <svg class="icon"><use href="/img/icons.svg#chevron"></use></svg></summary><div class="period-table"><% m.periodos.forEach(p=>{ %><div><span><%= p.nombre %> <small>(<%= p.ponderacion %>%)</small></span><b><%= p.nota===null?'Pendiente':Number(p.nota).toFixed(2) %></b></div><% }) %></div></details></article><% }) %>
</div></section><% }) %>
<div class="info-strip"><svg class="icon"><use href="/img/icons.svg#shield"></use></svg><p>La nota mínima de aprobación es <b>6.00/10.00</b>. Los promedios se consideran finales cuando el esquema suma 100% y todos los periodos tienen calificación.</p></div>
<%- include('../partials/footer') %>
