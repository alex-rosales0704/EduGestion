<%- include('../partials/header',{title}) %>
<section class="page-head"><div><a class="back-link" href="/docente"><svg class="icon"><use href="/img/icons.svg#arrow-left"></use></svg> Volver a mis asignaciones</a><h1>Registro de calificaciones</h1><p><b><%= asignacion.asignatura_nombre %></b> · Sección <%= asignacion.seccion_nombre %> · Ciclo <%= asignacion.ciclo_nombre %></p></div><span class="subtle-badge"><svg class="icon"><use href="/img/icons.svg#users"></use></svg> <%= alumnos.length %> estudiantes</span></section>
<% if(cicloCerrado) { %><div class="alert">El ciclo está cerrado. Las calificaciones se muestran en modo lectura.</div><% } %>
<% if(!periodos.length) { %><div class="alert">Primero el administrador debe configurar los periodos de evaluación.</div><% } %>
<div class="note-intro"><div class="note-intro-icon"><svg class="icon"><use href="/img/icons.svg#clipboard"></use></svg></div><p>Ingresa notas entre <b>0.00 y 10.00</b>. Los cambios se guardarán en MySQL. Solo puedes modificar tus asignaciones y periodos abiertos.</p></div>
<% periodos.forEach(periodo=>{const bloqueado=cicloCerrado||periodo.estado==='CERRADO';%>
<section class="card grade-card"><div class="data-toolbar"><div><h2><%= periodo.nombre %> <span class="weight-pill"><%= periodo.ponderacion %>% del promedio</span></h2><span>Calificaciones para la sección <%= asignacion.seccion_nombre %></span></div><span class="status-pill <%= bloqueado?'status-off':'status-active' %>"><%= bloqueado?'Bloqueado':'Editable' %></span></div>
<form method="post" action="/docente/asignaciones/<%= asignacion.id %>/notas"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="periodo_id" value="<%= periodo.id %>">
<div class="table-scroll"><table><thead><tr><th>Carnet</th><th>Estudiante</th><th>Calificación</th></tr></thead><tbody>
<% if(!alumnos.length){ %><tr><td colspan="3" class="empty-cell">No hay estudiantes matriculados.</td></tr><% } %>
<% alumnos.forEach(alumno=>{const key=alumno.matricula_id+':'+periodo.id; %><tr><td class="mono"><%= alumno.carnet %></td><td><span class="table-person"><span class="person-avatar"><%= alumno.estudiante.substring(0,1) %></span><b><%= alumno.estudiante %></b></span></td><td><div class="grade-input-wrap"><input aria-label="Nota para <%= alumno.estudiante %>" class="nota" type="number" name="notas[<%= alumno.matricula_id %>]" min="0" max="10" step="0.01" value="<%= mapa[key]??'' %>" <%= bloqueado?'disabled':'' %> placeholder="0.00"><span>/ 10</span></div></td></tr><% }) %>
</tbody></table></div><% if(!bloqueado && alumnos.length){ %><div class="grade-footer"><span>Los campos vacíos conservan la nota previamente registrada.</span><button class="btn primary" type="submit"><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Guardar calificaciones</button></div><% } %></form></section><% }) %>
<%- include('../partials/footer') %>
