<%- include('../partials/header',{title}) %>
<div class="login-shell">
  <section class="login-story">
    <div class="login-brand"><span class="logo-mark"><svg class="icon icon-lg"><use href="/img/icons.svg#school"></use></svg></span><span><b>EduGestion</b><small>WEB · CAMPUS</small></span></div>
    <div class="story-center"><div class="story-eyebrow"><span class="eyebrow-pip"></span> PLATAFORMA DE GESTIÓN ACADÉMICA</div>
    <h1>La educación,<br>mejor <em>conectada.</em></h1>
    <p>Información académica organizada, decisiones más claras y todo lo que tu institución necesita en un solo lugar.</p>
    <div class="story-visual"><div class="illustration-glow"></div><div class="visual-card visual-card-big"><span class="visual-mini-title"><svg class="icon"><use href="/img/icons.svg#chart"></use></svg> Rendimiento académico</span><div class="visual-chart"><i style="height:48%"></i><i style="height:67%"></i><i style="height:55%"></i><i style="height:77%"></i><i style="height:63%"></i><i style="height:92%"></i><i style="height:82%"></i></div><div class="visual-foot">Seguimiento en tiempo real <span>↗</span></div></div><div class="visual-card visual-card-floating"><div class="floating-check"><svg class="icon"><use href="/img/icons.svg#check"></use></svg></div><div><b>Notas actualizadas</b><small>Todo al día</small></div></div></div>
  </div>
    <div class="story-footer">Universidad Don Bosco · DWS901 <span>Proyecto académico · Sprint II</span></div>
  </section>
  <section class="login-panel">
    <div class="login-top-note"><span class="login-online-dot"></span> Acceso institucional</div>
    <div class="login-form-wrap"><div class="welcome-pill"><svg class="icon"><use href="/img/icons.svg#shield"></use></svg> Portal seguro</div><h2>¡Bienvenido de nuevo!</h2><p class="login-sub">Ingresa tus credenciales para acceder a tu espacio académico.</p>
      <% if(error) { %><div class="alert"><%= error %></div><% } %>
      <form class="login-form" method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
       <label for="correo">Correo institucional</label><div class="input-icon"><svg class="icon"><use href="/img/icons.svg#mail"></use></svg><input id="correo" type="email" name="correo" autocomplete="username" maxlength="150" required placeholder="correo@institucion.edu" autofocus></div>
       <div class="label-row"><label for="password">Contraseña</label><small>Acceso personal</small></div><div class="input-icon"><svg class="icon"><use href="/img/icons.svg#lock"></use></svg><input id="password" type="password" name="password" autocomplete="current-password" required placeholder="Ingresa tu contraseña"><button type="button" class="password-toggle" aria-label="Mostrar contraseña" data-toggle-password><svg class="icon"><use href="/img/icons.svg#eye"></use></svg></button></div>
       <button class="btn primary login-submit" type="submit">Ingresar a la plataforma <svg class="icon"><use href="/img/icons.svg#arrow-right"></use></svg></button>
      </form>
      <div class="demo-notice"><svg class="icon"><use href="/img/icons.svg#spark"></use></svg><div><b>¿Primera vez aquí?</b><span>Para la demostración, usa las cuentas ficticias indicadas en el README del proyecto.</span></div></div>
    </div>
    <div class="login-bottom">© 2026 EduGestion Web · Todos los derechos reservados.</div>
  </section>
</div>
<%- include('../partials/footer') %>
