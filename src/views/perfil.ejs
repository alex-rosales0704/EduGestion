<%- include('partials/header',{title}) %>
<section class="page-head"><div><div class="eyebrow">CUENTA <span class="eyebrow-divider"></span> SEGURIDAD</div><h1>Mi perfil</h1><p>Consulta tus datos de acceso y actualiza tu contraseña.</p></div></section>
<div class="profile-grid"><section class="card profile-card"><div class="profile-hero"><span class="profile-avatar"><%= cuenta.correo.substring(0,1).toUpperCase() %></span><h2><%= cuenta.rol.charAt(0)+cuenta.rol.slice(1).toLowerCase() %></h2><span class="status-pill status-active">Cuenta activa</span></div><div class="profile-detail"><span>Correo electrónico</span><b><%= cuenta.correo %></b></div><div class="profile-detail"><span>Rol institucional</span><b><%= cuenta.rol %></b></div><div class="profile-detail"><span>Acceso más reciente</span><b><%= cuenta.ultimo_acceso||'Sin registro' %></b></div></section>
<section class="card profile-security"><div class="form-section-head"><span class="form-section-icon"><svg class="icon"><use href="/img/icons.svg#lock"></use></svg></span><div><h2>Cambiar contraseña</h2><p>Protege tu información con una clave segura.</p></div></div><form method="post" action="/perfil/clave"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field-group"><label for="anterior">Contraseña actual</label><input id="anterior" name="anterior" type="password" required autocomplete="current-password"></div><div class="field-group"><label for="nueva">Contraseña nueva</label><input id="nueva" name="nueva" type="password" required minlength="8" maxlength="72" autocomplete="new-password"><small class="field-hint">De 8 a 72 caracteres</small></div><button class="btn primary" type="submit"><svg class="icon"><use href="/img/icons.svg#check"></use></svg> Guardar nueva contraseña</button></form></section></div>
<%- include('partials/footer') %>
